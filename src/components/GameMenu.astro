  /* ── Channels ───────────────────────────────────────────────────── */
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-sys-spacing-2);
  }
  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--md-sys-spacing-2);
    padding: var(--md-sys-spacing-2) var(--md-sys-spacing-3);
    text-decoration: none;
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-low);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-outline-variant);
    --cut: var(--md-sys-shape-cut-small);
    transition:
      --cut var(--md-sys-motion-spring-fast-spatial),
      color var(--md-sys-motion-spring-default-effects),
      border-color var(--md-sys-motion-spring-default-effects);
  }
  .social-btn:hover {
    --cut: var(--md-sys-shape-cut-large);
    color: var(--md-sys-color-primary);
    border-color: var(--md-sys-color-primary);
  }
  .social-key {
    color: var(--md-sys-color-accent);
    background: var(--md-sys-color-surface-container-highest);
  }
  .social-icon {
    color: var(--md-sys-color-outline);
  }
  .social-btn:hover .social-icon {
    color: var(--md-sys-color-primary);
  }

  /* ── Breakpoints ────────────────────────────────────────────────── */
  /* Below sm the on-page mode list is the navigation — the rail only keeps
     the sound toggle so it never overflows. */
  @media (max-width: 639px) {
    .rail-link:not(.sound-btn),
    .rail-sep {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .callout,
    .dim {
      display: flex;
    }
    .hints {
      display: flex;
    }
    .status-row {
      grid-template-columns: 8rem 1fr;
      gap: var(--md-sys-spacing-4);
    }
  }

  @media (min-width: 900px) {
    .schematic {
      padding: var(--md-sys-spacing-12) var(--md-sys-spacing-12);
    }
    .columns {
      grid-template-columns: 1.35fr 1fr;
    }
    .col {
      padding: var(--md-sys-spacing-12);
    }
    .col + .col {
      border-top: 0;
      border-left: var(--md-sys-frame-rule) solid
        var(--md-sys-color-outline-variant);
    }
    .rail {
      padding: var(--md-sys-spacing-4) var(--md-sys-spacing-12);
    }
  }
</style>

<script>
  // ── Schematic: crosshair readout, parallax, status ticker ────────────
  const drawing = document.getElementById("drawing");
  const readout = document.getElementById("readout");

  // ── Conway's Life, on the blueprint grid ─────────────────────────────
  const CELL = 16;
  const canvas = document.getElementById("life") as HTMLCanvasElement | null;
  const genEl = document.getElementById("life-gen");
  const stateEl = document.getElementById("life-state");

  let cols = 0;
  let rows = 0;
  let cells = new Uint8Array(0);
  let age = new Uint8Array(0);
  let gen = 0;
  let running = true;
  let onScreen = true;
  let lastTick = 0;
  /* Rects the simulation may run under but must not paint over. */
  let keepOut: Array<{ x0: number; y0: number; x1: number; y1: number }> = [];

  function measureKeepOut() {
    if (!drawing) return;
    const b = drawing.getBoundingClientRect();
    const pad = 10;
    keepOut = [...drawing.querySelectorAll(".specimen-wrap, .callout")].map(
      (el) => {
        const r = el.getBoundingClientRect();
        return {
          x0: r.left - b.left - pad,
          y0: r.top - b.top - pad,
          x1: r.right - b.left + pad,
          y1: r.bottom - b.top + pad,
        };
      },
    );
  }

  function blocked(px: number, py: number) {
    for (const k of keepOut) {
      if (px >= k.x0 && px <= k.x1 && py >= k.y0 && py <= k.y1) return true;
    }
    return false;
  }

  function seed() {
    gen = 0;
    cells = new Uint8Array(cols * rows);
    age = new Uint8Array(cols * rows);
    for (let i = 0; i < cells.length; i++) {
      cells[i] = Math.random() < 0.1 ? 1 : 0;
    }
    // Two gliders, so there is always something travelling across the sheet.
    const glider = [
      [1, 0],
      [2, 1],
      [0, 2],
      [1, 2],
      [2, 2],
    ];
    for (const [ox, oy] of [
      [2, 2],
      [cols - 8, rows - 8],
    ]) {
      for (const [dx, dy] of glider) {
        const x = ox + dx;
        const y = oy + dy;
        if (x >= 0 && x < cols && y >= 0 && y < rows) cells[y * cols + x] = 1;
      }
    }
  }

  function resize() {
    if (!canvas || !drawing) return;
    const b = drawing.getBoundingClientRect();
    if (!b.width || !b.height) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.floor(b.width * dpr);
    canvas.height = Math.floor(b.height * dpr);
    const ctx = canvas.getContext("2d");
    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    cols = Math.ceil(b.width / CELL);
    rows = Math.ceil(b.height / CELL);
    measureKeepOut();
    seed();
    draw();
  }

  function step() {
    const next = new Uint8Array(cells.length);
    const nextAge = new Uint8Array(cells.length);
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        let n = 0;
        for (let dy = -1; dy <= 1; dy++) {
          for (let dx = -1; dx <= 1; dx++) {
            if (!dx && !dy) continue;
            // Toroidal, so gliders wrap instead of dying at the edge.
            const nx = (x + dx + cols) % cols;
            const ny = (y + dy + rows) % rows;
            n += cells[ny * cols + nx];
          }
        }
        const i = y * cols + x;
        const alive = cells[i] === 1;
        if (alive ? n === 2 || n === 3 : n === 3) {
          next[i] = 1;
          nextAge[i] = alive ? Math.min(age[i] + 1, 255) : 0;
        }
      }
    }
    cells = next;
    age = nextAge;
    gen++;
    if (genEl) genEl.textContent = String(gen).padStart(4, "0");
  }

  let inkNew = "rgba(255, 195, 29, 0.34)";
  let inkSettled = "rgba(54, 127, 252, 0.2)";

  function readInks() {
    const cs = getComputedStyle(document.documentElement);
    inkNew = cs.getPropertyValue("--md-sys-color-life-new").trim() || inkNew;
    inkSettled =
      cs.getPropertyValue("--md-sys-color-life-settled").trim() || inkSettled;
  }

  function draw() {
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const w = canvas.width / (Math.min(window.devicePixelRatio || 1, 2) || 1);
    const h = canvas.height / (Math.min(window.devicePixelRatio || 1, 2) || 1);
    ctx.clearRect(0, 0, w, h);
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        if (!cells[y * cols + x]) continue;
        if (blocked(x * CELL + CELL / 2, y * CELL + CELL / 2)) continue;
        // Newborn cells flash accent, settled ones cool to blue.
        ctx.fillStyle = age[y * cols + x] === 0 ? inkNew : inkSettled;
        ctx.fillRect(x * CELL + 1, y * CELL + 1, CELL - 1, CELL - 1);
      }
    }
  }

  function frame(t: number) {
    if (running && onScreen && t - lastTick > 420) {
      lastTick = t;
      step();
      draw();
    }
    requestAnimationFrame(frame);
  }

  function setRunning(next: boolean) {
    running = next;
    if (stateEl) stateEl.textContent = running ? "Pause" : "Play";
  }

  if (canvas && drawing) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    readInks();
    resize();
    // Repaint with the new inks when the scheme flips.
    new MutationObserver(() => {
      readInks();
      draw();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    new ResizeObserver(resize).observe(drawing);
    new IntersectionObserver((entries) => {
      onScreen = entries[0]?.isIntersecting ?? true;
    }).observe(drawing);

    if (reduced) setRunning(false);
    else requestAnimationFrame(frame);

    document
      .getElementById("life-toggle")
      ?.addEventListener("click", () => setRunning(!running));
    document.getElementById("life-reseed")?.addEventListener("click", () => {
      seed();
      draw();
      if (genEl) genEl.textContent = "0000";
    });
  }

  // ── Crosshair, parallax, and painting cells ──────────────────────────
  if (drawing && matchMedia("(hover: hover)").matches) {
    let painting = false;

    const paint = (e: PointerEvent) => {
      const b = drawing.getBoundingClientRect();
      const cx = Math.floor((e.clientX - b.left) / CELL);
      const cy = Math.floor((e.clientY - b.top) / CELL);
      // A 2x2 blob, so a single click is more likely to survive a generation.
      for (const [dx, dy] of [
        [0, 0],
        [1, 0],
        [0, 1],
        [1, 1],
      ]) {
        const x = cx + dx;
        const y = cy + dy;
        if (x >= 0 && x < cols && y >= 0 && y < rows) cells[y * cols + x] = 1;
      }
      draw();
    };

    drawing.addEventListener("pointermove", (e) => {
      const b = drawing.getBoundingClientRect();
      const x = e.clientX - b.left;
      const y = e.clientY - b.top;
      drawing.style.setProperty("--mx", `${x}px`);
      drawing.style.setProperty("--my", `${y}px`);
      drawing.style.setProperty("--px", `${x / b.width}`);
      drawing.style.setProperty("--py", `${y / b.height}`);
      drawing.dataset.tracking = "true";
      if (readout) {
        const cx = String(Math.floor(x / CELL)).padStart(3, "0");
        const cy = String(Math.floor(y / CELL)).padStart(3, "0");
        readout.textContent = `Cell ${cx},${cy}`;
      }
      if (painting) paint(e);
    });

    drawing.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement).closest(".life-hud")) return;
      painting = true;
      paint(e);
    });
    window.addEventListener("pointerup", () => {
      painting = false;
    });

    drawing.addEventListener("pointerleave", () => {
      painting = false;
      drawing.dataset.tracking = "false";
      drawing.style.setProperty("--px", "0.5");
      drawing.style.setProperty("--py", "0.5");
    });
  }

  // Title-block status line — real facts, cycled like an instrument readout.
  const ticker = document.getElementById("ticker");
  if (ticker) {
    const lines = [
      "System: Ready",
      "Uptime: 6+ Yrs",
      "Stack: Node // AWS // AI",
      "Loc: Uttarakhand, IN",
      "Status: Open to work",
    ];
    let i = 0;
    setInterval(() => {
      i = (i + 1) % lines.length;
      ticker.textContent = lines[i];
    }, 3200);
  }

  const STORAGE_KEY = "pavittarx:sound";

  let soundOn = (() => {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored === null ? true : stored === "on";
    } catch {
      return true;
    }
  })();

  function setSoundButtonState() {
    const toggle = document.getElementById("sound-toggle");
    if (!toggle) return;
    const on = toggle.querySelector('[data-state="on"]') as HTMLElement | null;
    const off = toggle.querySelector(
      '[data-state="off"]',
    ) as HTMLElement | null;
    if (on && off) {
      on.classList.toggle("hidden", !soundOn);
      off.classList.toggle("hidden", soundOn);
    }
  }
  setSoundButtonState();

  let audioCtx: AudioContext | null = null;
  function getCtx() {
    if (!audioCtx) {
      const AC =
        (window.AudioContext as typeof AudioContext) ||
        ((window as any).webkitAudioContext as typeof AudioContext);
      audioCtx = new AC();
    }
    return audioCtx;
  }

  function playHoverSound() {
    if (!soundOn) return;
    const ctx = getCtx();
    if (ctx.state === "suspended") ctx.resume();
    const osc = ctx.createOscillator();
    const gainNode = ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(440, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.05);
    gainNode.gain.setValueAtTime(0.05, ctx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
    osc.connect(gainNode);
    gainNode.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.05);
  }

  function playClickSound() {
    if (!soundOn) return;
    const ctx = getCtx();
    if (ctx.state === "suspended") ctx.resume();
    const osc = ctx.createOscillator();
    const gainNode = ctx.createGain();
    osc.type = "square";
    osc.frequency.setValueAtTime(880, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(220, ctx.currentTime + 0.1);
    gainNode.gain.setValueAtTime(0.05, ctx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
    osc.connect(gainNode);
    gainNode.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.1);
  }

  document.getElementById("sound-toggle")?.addEventListener("click", () => {
    soundOn = !soundOn;
    try {
      localStorage.setItem(STORAGE_KEY, soundOn ? "on" : "off");
    } catch {}
    setSoundButtonState();
    if (soundOn) playClickSound();
  });

  const menuItems = document.querySelectorAll(".menu-item");
  let currentIndex = -1;

  function setActive(index: number) {
    (menuItems[index] as HTMLElement | undefined)?.focus();
    currentIndex = index;
  }

  menuItems.forEach((item, index) => {
    item.addEventListener("mouseenter", () => {
      if (currentIndex !== index) {
        playHoverSound();
        currentIndex = index;
        (item as HTMLElement).focus();
      }
    });
    item.addEventListener("click", () => playClickSound());
  });

  document.querySelectorAll(".social-btn").forEach((btn) => {
    btn.addEventListener("mouseenter", () => playHoverSound());
    btn.addEventListener("click", () => playClickSound());
  });

  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    if (
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable)
    ) {
      return;
    }

    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(currentIndex === -1 ? 0 : (currentIndex + 1) % menuItems.length);
      playHoverSound();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(
        currentIndex === -1
          ? menuItems.length - 1
          : (currentIndex - 1 + menuItems.length) % menuItems.length,
      );
      playHoverSound();
    } else if (e.key === "Enter") {
      if (currentIndex !== -1) playClickSound();
    } else {
      const key = e.key.toUpperCase();
      const social = document.querySelector(
        `.social-btn[data-shortcut="${key}"]`,
      ) as HTMLAnchorElement | null;
      if (social) {
        e.preventDefault();
        playClickSound();
        social.click();
      }
    }
  });
</script>

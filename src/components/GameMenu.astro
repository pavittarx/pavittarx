---
import { Image } from "astro:assets";
import logo from "../assets/pavittarx-logo.svg";

const menuItems = [
  { label: "Timeline View", href: "/timeline" },
  { label: "Skills Tree", href: "/skills" },
  { label: "Projects Showcase", href: "/projects" },
  { label: "Blog Updates", href: "/blog" },
];

const status = [
  {
    label: "CURRENTLY",
    value: "Sr. Engineer @ Kuby Ltd. (Cyprus · Remote)",
  },
  {
    label: "FOCUS",
    value: "Backend / AI tooling on Anthropic Claude SDK",
  },
  { label: "LOCATION", value: "Nainital, India" },
];

const socials = [
  {
    key: "G",
    label: "GITHUB",
    href: "https://github.com/pavittarx",
    icon: "↗",
    external: true,
  },
  {
    key: "L",
    label: "LINKEDIN",
    href: "https://linkedin.com/in/pavittarx",
    icon: "↗",
    external: true,
  },
  {
    key: "E",
    label: "EMAIL",
    href: "mailto:pavittarx@gmail.com",
    icon: "↗",
    external: false,
  },
  {
    key: "R",
    label: "RESUME",
    href: "/Pavittar-Singh-Senior-Software-Engineer.pdf",
    icon: "↓",
    external: true,
    download: true,
  },
];
---

<div
  class="game-shell relative min-h-screen bg-gray-900 flex items-center justify-center p-4 sm:p-6 md:p-8 font-mono text-white overflow-hidden"
>
  <!-- Scanline overlay -->
  <div class="scanlines pointer-events-none absolute inset-0 z-50"></div>

  <!-- Sound toggle -->
  <button
    id="sound-toggle"
    type="button"
    aria-label="Toggle sound"
    class="fixed top-3 right-3 sm:top-6 sm:right-6 z-50 px-2.5 py-1 sm:px-3 sm:py-1.5 text-[10px] sm:text-xs font-mono uppercase tracking-widest text-gray-400 hover:text-[#2575FC] border border-gray-700 hover:border-[#2575FC]/60 bg-[#0f111a]/80 backdrop-blur-sm clip-corner-sm transition-all duration-200"
  >
    <span data-state="on">[ SOUND : ON ]</span>
    <span data-state="off" class="hidden">[ SOUND : OFF ]</span>
  </button>

  <div
    class="relative z-10 max-w-7xl w-full grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center py-12 lg:py-0"
  >
    <!-- Left: Identity + Status -->
    <div
      class="flex flex-col items-center lg:items-end justify-center border-r-0 lg:border-r border-gray-700 pr-0 lg:pr-16 text-center lg:text-right"
    >
      <div
        class="flex justify-center lg:justify-end mb-6 sm:mb-8 hover:scale-105 transition-transform duration-300"
      >
        <Image
          src={logo}
          alt="Pavittarx Logo"
          class="h-20 sm:h-24 lg:h-28 w-auto drop-shadow-xl"
        />
      </div>

      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-7xl mb-4 sm:mb-6">
        <span class="block text-gray-400 text-2xl sm:text-3xl lg:text-4xl font-medium mb-2"
          >Hey there, I'm</span
        >
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#2575FC] via-indigo-600 to-purple-600"
        >
          Pavittar
        </span>
      </h1>

      <p class="mt-4 sm:mt-6 text-sm sm:text-base leading-6 sm:leading-7 text-gray-400 max-w-xl">
        Senior software engineer with 6+ years building product-grade backends
        and full-stack web apps for SaaS and consumer startups. Currently
        focused on scalable Node/NestJS systems on AWS, with hands-on AI and
        agentic tooling.
      </p>

      <!-- Status block -->
      <div
        class="status-block mt-6 sm:mt-8 w-full max-w-xl text-left bg-[#0f111a]/80 border border-gray-800 clip-corner backdrop-blur-sm p-3 sm:p-4"
        aria-label="Current status"
      >
        <div class="flex items-baseline gap-2 text-[11px] sm:text-xs text-[#2575FC] font-mono">
          <span>&gt; STATUS_</span>
          <span class="status-cursor inline-block w-2 h-3 bg-[#2575FC]"></span>
        </div>
        <dl class="mt-3 space-y-1.5 text-[11px] sm:text-xs font-mono">
          {
            status.map((row) => (
              <div class="grid grid-cols-[7rem_1fr] sm:grid-cols-[auto_1fr] gap-x-3">
                <dt class="text-gray-600 uppercase tracking-widest">
                  {row.label}
                </dt>
                <dd class="text-gray-300 break-words">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Socials as controller buttons -->
      <div
        class="mt-6 sm:mt-8 flex flex-wrap justify-center lg:justify-end gap-2 sm:gap-3 w-full max-w-xl"
      >
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.external ? "_blank" : undefined}
              rel={s.external ? "noopener noreferrer" : undefined}
              download={s.download ? "" : undefined}
              data-shortcut={s.key}
              class="social-btn group inline-flex items-center gap-1.5 sm:gap-2 px-2.5 py-1 sm:px-3 sm:py-1.5 text-[10px] sm:text-xs font-mono uppercase tracking-widest text-gray-400 hover:text-[#2575FC] border border-gray-700 hover:border-[#2575FC]/60 bg-[#0f111a]/60 hover:bg-[#0f111a] clip-corner-sm transition-all duration-200"
            >
              <kbd class="hidden sm:inline-block px-1 py-0.5 text-[10px] bg-gray-800 border border-gray-700 rounded text-gray-500 group-hover:text-[#2575FC]">
                {s.key}
              </kbd>
              <span>{s.label}</span>
              <span class="text-gray-600 group-hover:text-[#2575FC]">
                {s.icon}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Right: Menu Options -->
    <div class="flex flex-col gap-6 sm:gap-8 pl-0 lg:pl-12">
      <nav id="game-menu" class="flex flex-col gap-3 sm:gap-4">
        {
          menuItems.map((item, index) => (
            <a
              href={item.href}
              class="menu-item group relative px-5 sm:px-8 py-4 sm:py-5 text-lg sm:text-2xl font-bold tracking-wider transition-all duration-200 hover:translate-x-2 sm:hover:translate-x-4 focus:translate-x-2 sm:focus:translate-x-4 focus:outline-none outline-none"
              data-index={index}
            >
              <span class="absolute left-0 top-1/2 -translate-y-1/2 w-0 h-full bg-gradient-to-r from-[#2575FC]/20 to-transparent transition-all duration-200 group-hover:w-full group-focus:w-full -z-10 rounded-r-xl border-l-4 border-transparent group-hover:border-[#2575FC] group-focus:border-[#2575FC]" />

              <div class="flex items-center gap-3 sm:gap-4">
                <span class="text-gray-600 group-hover:text-[#2575FC] group-focus:text-[#2575FC] transition-colors font-mono text-sm sm:text-lg">
                  0{index + 1}
                </span>
                <span class="text-gray-400 group-hover:text-white group-focus:text-white transition-colors">
                  {item.label}
                </span>
              </div>
            </a>
          ))
        }
      </nav>

      <div
        class="hidden sm:flex mt-8 lg:mt-12 text-xs text-gray-600 flex-wrap gap-x-6 gap-y-3 font-mono uppercase tracking-widest"
      >
        <div class="flex items-center gap-2">
          <div class="flex gap-1">
            <kbd
              class="px-1.5 py-0.5 bg-gray-800 rounded border border-gray-700 text-gray-400"
              >↑</kbd
            >
            <kbd
              class="px-1.5 py-0.5 bg-gray-800 rounded border border-gray-700 text-gray-400"
              >↓</kbd
            >
          </div>
          <span>Navigate</span>
        </div>
        <div class="flex items-center gap-2">
          <kbd
            class="px-1.5 py-0.5 bg-gray-800 rounded border border-gray-700 text-gray-400"
            >↵</kbd
          >
          <span>Select</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex gap-1">
            <kbd
              class="px-1.5 py-0.5 bg-gray-800 rounded border border-gray-700 text-gray-400"
              >G</kbd
            >
            <kbd
              class="px-1.5 py-0.5 bg-gray-800 rounded border border-gray-700 text-gray-400"
              >L</kbd
            >
            <kbd
              class="px-1.5 py-0.5 bg-gray-800 rounded border border-gray-700 text-gray-400"
              >E</kbd
            >
            <kbd
              class="px-1.5 py-0.5 bg-gray-800 rounded border border-gray-700 text-gray-400"
              >R</kbd
            >
          </div>
          <span>Shortcuts</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .clip-corner {
    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );
  }
  .clip-corner-sm {
    clip-path: polygon(
      4px 0,
      100% 0,
      100% calc(100% - 4px),
      calc(100% - 4px) 100%,
      0 100%,
      0 4px
    );
  }

  /* Blinking cursor */
  @keyframes status-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .status-cursor {
    animation: status-blink 1s steps(1) infinite;
  }

  /* CRT scanlines */
  .scanlines {
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0px,
      rgba(255, 255, 255, 0) 2px,
      rgba(0, 0, 0, 0.12) 3px,
      rgba(0, 0, 0, 0.12) 3px
    );
    mix-blend-mode: multiply;
    opacity: 0.5;
  }
  @media (max-width: 640px) {
    .scanlines {
      opacity: 0.3;
    }
  }
  .game-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 60%,
      rgba(0, 0, 0, 0.35) 100%
    );
    z-index: 40;
  }
</style>

<script>
  const STORAGE_KEY = "pavittarx:sound";

  // Sound state — persisted in localStorage. Default = on.
  let soundOn = (() => {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored === null ? true : stored === "on";
    } catch {
      return true;
    }
  })();

  function setSoundButtonState() {
    const toggle = document.getElementById("sound-toggle");
    if (!toggle) return;
    const on = toggle.querySelector('[data-state="on"]') as HTMLElement | null;
    const off = toggle.querySelector('[data-state="off"]') as HTMLElement | null;
    if (on && off) {
      on.classList.toggle("hidden", !soundOn);
      off.classList.toggle("hidden", soundOn);
    }
  }
  setSoundButtonState();

  // Web Audio
  let audioCtx: AudioContext | null = null;
  function getCtx() {
    if (!audioCtx) {
      const AC =
        (window.AudioContext as typeof AudioContext) ||
        ((window as any).webkitAudioContext as typeof AudioContext);
      audioCtx = new AC();
    }
    return audioCtx;
  }

  function playHoverSound() {
    if (!soundOn) return;
    const ctx = getCtx();
    if (ctx.state === "suspended") ctx.resume();
    const osc = ctx.createOscillator();
    const gainNode = ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(440, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.05);
    gainNode.gain.setValueAtTime(0.05, ctx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
    osc.connect(gainNode);
    gainNode.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.05);
  }

  function playClickSound() {
    if (!soundOn) return;
    const ctx = getCtx();
    if (ctx.state === "suspended") ctx.resume();
    const osc = ctx.createOscillator();
    const gainNode = ctx.createGain();
    osc.type = "square";
    osc.frequency.setValueAtTime(880, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(220, ctx.currentTime + 0.1);
    gainNode.gain.setValueAtTime(0.05, ctx.currentTime);
    gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
    osc.connect(gainNode);
    gainNode.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + 0.1);
  }

  // Sound toggle handler
  document.getElementById("sound-toggle")?.addEventListener("click", () => {
    soundOn = !soundOn;
    try {
      localStorage.setItem(STORAGE_KEY, soundOn ? "on" : "off");
    } catch {}
    setSoundButtonState();
    if (soundOn) playClickSound();
  });

  // Menu navigation
  const menuItems = document.querySelectorAll(".menu-item");
  let currentIndex = -1;

  function setActive(index: number) {
    menuItems.forEach((item, i) => {
      if (i === index) {
        (item as HTMLElement).focus();
      }
    });
    currentIndex = index;
  }

  menuItems.forEach((item, index) => {
    item.addEventListener("mouseenter", () => {
      if (currentIndex !== index) {
        playHoverSound();
        currentIndex = index;
        (item as HTMLElement).focus();
      }
    });
    item.addEventListener("click", () => {
      playClickSound();
    });
  });

  // Social hover/click sounds
  document.querySelectorAll(".social-btn").forEach((btn) => {
    btn.addEventListener("mouseenter", () => playHoverSound());
    btn.addEventListener("click", () => playClickSound());
  });

  // Keyboard handlers
  document.addEventListener("keydown", (e) => {
    // Ignore when user is typing in an input
    const target = e.target as HTMLElement | null;
    if (
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable)
    ) {
      return;
    }

    if (e.key === "ArrowDown") {
      e.preventDefault();
      if (currentIndex === -1) {
        setActive(0);
      } else {
        setActive((currentIndex + 1) % menuItems.length);
      }
      playHoverSound();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (currentIndex === -1) {
        setActive(menuItems.length - 1);
      } else {
        setActive(
          (currentIndex - 1 + menuItems.length) % menuItems.length,
        );
      }
      playHoverSound();
    } else if (e.key === "Enter") {
      if (currentIndex !== -1) {
        playClickSound();
      }
    } else {
      // Social shortcut keys
      const key = e.key.toUpperCase();
      const social = document.querySelector(
        `.social-btn[data-shortcut="${key}"]`,
      ) as HTMLAnchorElement | null;
      if (social) {
        e.preventDefault();
        playClickSound();
        social.click();
      }
    }
  });
</script>

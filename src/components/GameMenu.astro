  }
  .status-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding-bottom: var(--md-sys-spacing-3);
    border-bottom: var(--md-sys-frame-rule) solid
      var(--md-sys-color-outline-variant);

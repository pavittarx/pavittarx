---
import { Image } from "astro:assets";
import logo from "../assets/pavittarx-logo.svg";

const menuItems = [
  {
    label: "Timeline View",
    href: "/timeline",
    hint: "Career, writing and releases, by year",
  },
  {
    label: "Skills Tree",
    href: "/skills",
    hint: "Stack, depth and dependencies",
  },
  {
    label: "Projects Showcase",
    href: "/projects",
    hint: "Things shipped and open sourced",
  },
  { label: "Blog Updates", href: "/blog", hint: "Notes on systems and scale" },
];

const status = [
  { label: "Currently", value: "Sr. Engineer @ Kuby Ltd. (Cyprus · Remote)" },
  { label: "Focus", value: "Backend / AI tooling on Anthropic Claude SDK" },
  { label: "Location", value: "Uttarakhand, India" },
];

// Schematic callouts — read clockwise from the top-left of the drawing.
const callouts = [
  { key: "A", value: "Node · NestJS · Postgres", side: "left", top: "22%" },
  { key: "B", value: "AWS · Docker · CI/CD", side: "left", top: "62%" },
  { key: "C", value: "Next.js · Astro · TS", side: "right", top: "22%" },
  { key: "D", value: "Claude SDK · Agents", side: "right", top: "62%" },
];

const RESUME_FILENAME = "Pavittar-Singh-Senior-Software-Engineer.pdf";

interface SocialLink {
  readonly key: string;
  readonly label: string;
  readonly href: string;
  readonly icon: string;
  readonly external: boolean;
  /** Explicit filename. A bare `download` lets the browser name the file,
      which combined with target=_blank yields a UUID instead of the title. */
  readonly downloadAs?: string;
}

const socials: readonly SocialLink[] = [
  {
    key: "G",
    label: "Github",
    href: "https://github.com/pavittarx",
    icon: "↗",
    external: true,
  },
  {
    key: "L",
    label: "LinkedIn",
    href: "https://linkedin.com/in/pavittarx",
    icon: "↗",
    external: true,
  },
  {
    key: "E",
    label: "Email",
    href: "mailto:pavittarx@gmail.com",
    icon: "↗",
    external: false,
  },
  {
    key: "R",
    label: "Resume",
    href: `/${RESUME_FILENAME}`,
    icon: "↓",
    // A download is not a navigation — opening a tab is what broke the name.
    external: false,
    downloadAs: RESUME_FILENAME,
  },
];
---

<div class="shell">
  <div class="scanlines" aria-hidden="true"></div>

  <div class="frame">
    <!-- ── Nav rail ─────────────────────────────────────────────────── -->
    <nav class="rail rail-nav">
      <a href="/" class="brand">
        <Image src={logo} alt="" class="brand-mark" />
        <span class="md-label-large brand-name">Pavittar Singh</span>
      </a>

      <div class="rail-links">
        {
          menuItems.map((item, i) => (
            <>
              {i > 0 && <span class="rail-sep">/</span>}
              <a href={item.href} class="md-label-medium rail-link">
                {item.label.split(" ")[0]}
              </a>
            </>
          ))
        }
        <span class="rail-sep">/</span>
        <button
          id="sound-toggle"
          type="button"
          class="md-label-medium rail-link sound-btn"
        >
          <span data-state="on">Sound: On</span>
          <span data-state="off" class="hidden">Sound: Off</span>
        </button>
        <span class="rail-sep">/</span>
        <button
          type="button"
          class="md-label-medium rail-link theme-toggle"
          data-theme-toggle
          aria-label="Toggle colour scheme"
        >
          <span data-theme-label>Dark</span>
        </button>
      </div>
    </nav>

    <main>
      <!-- ── Schematic ──────────────────────────────────────────────── -->
      <section class="schematic">
      <header class="sheet-head">
        <div>
          <p class="md-label-medium sheet-id">Pavittarx // Schematic</p>
          <p class="md-label-small sheet-sub">Model X1 // Ref: 2019—2026</p>
        </div>
        <div class="sheet-head-right">
          <p class="md-label-medium sheet-id">Fig. 01</p>
          <p class="md-label-small sheet-sub">Scale 1:1</p>
        </div>
      </header>

      <div id="drawing" class="drawing md-blueprint">
        <span class="md-reg-mark" data-corner="tl"></span>
        <span class="md-reg-mark" data-corner="tr"></span>
        <span class="md-reg-mark" data-corner="bl"></span>
        <span class="md-reg-mark" data-corner="br"></span>

        <!-- Conway's Life, played on the blueprint grid itself. -->
        <canvas id="life" class="life" aria-hidden="true"></canvas>

        <!-- Cursor-tracked crosshair, the way a CAD viewport shows position. -->
        <span class="crosshair crosshair-x" aria-hidden="true"></span>
        <span class="crosshair crosshair-y" aria-hidden="true"></span>
        <span id="readout" class="md-label-small readout" aria-hidden="true">
          Cell ---,---
        </span>

        {
          callouts.map((c, i) => (
            <div
              class="callout"
              data-side={c.side}
              style={`top:${c.top}; --boot-delay: ${0.55 + i * 0.09}s`}
            >
              <span class="md-label-small callout-key">{c.key}</span>
              <span class="callout-line" />
              <span class="md-label-small callout-value">{c.value}</span>
            </div>
          ))
        }

        <div class="specimen-wrap">
          <!-- Dimension lines measure the career, not the drawing. -->
          <span class="dim dim-v" aria-hidden="true">
            <span class="md-label-small dim-label">6+ yrs</span>
          </span>

          <div class="specimen md-blueprint-fine">
            <!-- Same mark as the nav rail, but drafted rather than filled:
                 outlines only, in the drawing's own two inks. -->
            <svg
              class="specimen-mark"
              viewBox="0 0 450 435"
              fill="none"
              role="img"
              aria-label="Pavittarx"
            >
              <path
                class="ink ink-fill"
                pathLength="1"
                d="M404.159 77.568V137.65L332.659 222.802L259.659 228.802L315.659 191.802L344.159 109.802L204.954 77.568L261.892 137.65L186.159 333.302L175.159 315.302L213.709 148.251L100.659 62.3018L155.659 47.8018L404.159 77.568Z"
              ></path>
              <path
                class="ink ink-shell"
                pathLength="1"
                d="M278.224 122.173L288.012 132.501L282.875 145.771L261.694 200.489L296.904 177.225L314.684 126.071L272.707 116.352L278.224 122.173ZM426.659 145.844L421.391 152.118L349.891 237.271L343.856 244.457L334.502 245.227L261.502 251.227L252.326 224.691L207.142 341.424L190.705 383.889L166.96 345.034L155.96 327.034L151.17 319.194L153.235 310.242L188.515 157.36L87.0421 80.2129L50.3292 52.3018L94.924 40.5449L149.924 26.0449L154.073 24.9512L158.335 25.4619L406.835 55.2275L426.659 57.6025V145.844Z"
              ></path>
            </svg>
          </div>

          <span class="dim dim-h" aria-hidden="true">
            <span class="md-label-small dim-label">2019 — 2026</span>
          </span>
        </div>

        <p class="md-label-small drawing-foot drawing-foot-left">
          <span id="ticker">System: Ready</span><span class="cursor"></span>
        </p>

        <div class="life-hud md-label-small">
          <button id="life-toggle" type="button" class="life-btn md-cut">
            <span id="life-state">Pause</span>
          </button>
          <button id="life-reseed" type="button" class="life-btn md-cut">
            Reseed
          </button>
          <span class="life-gen">Gen <span id="life-gen">0000</span></span>
          <a
            href="https://github.com/pavittarx/game-of-life"
            target="_blank"
            rel="noopener noreferrer"
            class="life-src">Life ↗</a
          >
        </div>

        <p class="md-label-small drawing-foot drawing-foot-right">
          Rev 002<br />Pavittarx
        </p>
      </div>

      <h1 class="md-display-large headline">
        <span class="sr-only">Pavittar Singh — </span>Senior Software Engineer
      </h1>

      <p class="md-body-large intro">
        6+ years building product-grade backends and full-stack web apps for
        SaaS and consumer startups. Currently on scalable Node/NestJS systems
        over AWS, with hands-on AI and agentic tooling.
      </p>
    </section>

    <!-- ── Mode select ──────────────────────────────────────────────── -->
    <section class="columns">
      <div class="col">
        <p class="md-label-medium section-label">// Select a mode</p>
        <nav id="game-menu" class="menu">
          {
            menuItems.map((item, index) => (
              <a
                href={item.href}
                class="menu-item md-cut md-state-layer"
                data-index={index}
              >
                <span class="md-label-small menu-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="menu-text">
                  <span class="md-display-small menu-label">{item.label}</span>
                  <span class="md-body-small menu-hint">{item.hint}</span>
                </span>
                <span class="menu-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </nav>

        <div class="hints">
          <span class="hint"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
          <span class="hint"><kbd>↵</kbd> Select</span>
          <span class="hint">
            <kbd>G</kbd><kbd>L</kbd><kbd>E</kbd><kbd>R</kbd> Shortcuts
          </span>
        </div>
      </div>

      <div class="col">
        <p class="md-label-medium section-label">// Status</p>
        <dl class="status">
          {
            status.map((row) => (
              <div class="status-row">
                <dt class="md-label-small status-key">{row.label}</dt>
                <dd class="md-body-medium status-value">{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <p class="md-label-medium section-label">// Channels</p>
        <div class="channels">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target={s.external ? "_blank" : undefined}
                rel={s.external ? "noopener noreferrer" : undefined}
                download={s.downloadAs}
                data-shortcut={s.key}
                class="social-btn md-cut md-state-layer"
              >
                <kbd class="social-key">{s.key}</kbd>
                <span class="md-label-medium social-label">{s.label}</span>
                <span class="social-icon">{s.icon}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    </main>

    <footer class="rail rail-foot">
      <span class="md-label-small">© 2026 Pavittar Singh</span>
      <span class="md-label-small">Built with Astro // Deployed on Vercel</span>
    </footer>
  </div>
</div>

<style>
  /* ── Shell & frame ──────────────────────────────────────────────── */
  .shell {
    position: relative;
    min-height: 100vh;
    background: var(--md-sys-color-surface);
    padding: var(--md-sys-frame-inset);
  }

  .frame {
    position: relative;
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-outline-variant);
    overflow: clip;
  }

  .scanlines {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0px,
      rgba(255, 255, 255, 0) 2px,
      var(--md-sys-scanline-ink) 3px,
      var(--md-sys-scanline-ink) 3px
    );
    opacity: var(--md-sys-scanline-opacity);
  }

  /* ── Rails ──────────────────────────────────────────────────────── */
  .rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md-sys-spacing-4);
    padding: var(--md-sys-spacing-4) var(--md-sys-spacing-6);
  }
  .rail-nav {
    border-bottom: var(--md-sys-frame-rule) solid
      var(--md-sys-color-outline-variant);
  }
  .rail-foot {
    border-top: var(--md-sys-frame-rule) solid
      var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-outline);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--md-sys-spacing-3);
    padding: var(--md-sys-spacing-1) var(--md-sys-spacing-2);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
  }
  .brand-mark {
    height: 26px;
    width: auto;
  }
  .brand-name {
    color: var(--md-sys-color-on-surface);
    white-space: nowrap;
  }

  .rail-links {
    display: flex;
    align-items: center;
    gap: var(--md-sys-spacing-3);
  }
  .rail-sep {
    color: var(--md-sys-color-outline-variant);
    font-family: var(--md-sys-typescale-mono-font);
  }
  .rail-link {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
    color: var(--md-sys-color-on-surface-variant);
    transition: color var(--md-sys-motion-spring-fast-effects);
  }
  .rail-link:hover {
    color: var(--md-sys-color-primary);
  }
  .sound-btn {
    font-size: var(--md-sys-typescale-label-medium-size);
  }
  .hidden {
    display: none;
  }

  /* ── Schematic ──────────────────────────────────────────────────── */
  .schematic {
    padding: var(--md-sys-spacing-8) var(--md-sys-spacing-6)
      var(--md-sys-spacing-12);
  }

  .sheet-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--md-sys-spacing-4);
  }
  .sheet-head-right {
    text-align: right;
  }
  .sheet-id {
    color: var(--md-sys-color-accent);
    margin: 0;
  }
  .sheet-sub {
    color: var(--md-sys-color-outline);
    margin: 2px 0 0;
  }

  .drawing {
    position: relative;
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-blueprint-rule);
    min-height: clamp(320px, 44vh, 470px);
    display: grid;
    place-items: center;
    overflow: hidden;
    animation: grid-in 0.9s var(--md-sys-motion-easing-emphasized) both;
    /* Minor 16px / major 64px — engineering paper, and the minor square is
       exactly one Life cell so live cells land inside the ruling. */
    background-image:
      linear-gradient(var(--md-sys-color-blueprint-grid) 1px, transparent 1px),
      linear-gradient(
        90deg,
        var(--md-sys-color-blueprint-grid) 1px,
        transparent 1px
      ),
      linear-gradient(var(--md-sys-color-blueprint-rule) 1px, transparent 1px),
      linear-gradient(
        90deg,
        var(--md-sys-color-blueprint-rule) 1px,
        transparent 1px
      );
    background-size:
      16px 16px,
      16px 16px,
      64px 64px,
      64px 64px;
  }
  .drawing .md-reg-mark {
    animation: boot-in 0.4s var(--md-sys-motion-easing-emphasized) 0.15s both;
  }

  /* ── Life ───────────────────────────────────────────────────────── */
  .life {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    animation: grid-in 1.2s var(--md-sys-motion-easing-emphasized) 0.4s both;
  }

  .life-hud {
    position: absolute;
    top: var(--md-sys-spacing-4);
    right: var(--md-sys-spacing-6);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--md-sys-spacing-3);
    color: var(--md-sys-color-outline);
  }
  .life-btn {
    cursor: pointer;
    padding: 3px 8px;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-low);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-outline-variant);
    --cut: var(--md-sys-shape-cut-extra-small);
    transition:
      --cut var(--md-sys-motion-spring-fast-spatial),
      color var(--md-sys-motion-spring-default-effects),
      border-color var(--md-sys-motion-spring-default-effects);
  }
  .life-btn:hover {
    --cut: var(--md-sys-shape-cut-small);
    color: var(--md-sys-color-primary);
    border-color: var(--md-sys-color-primary);
  }
  .life-gen {
    color: var(--md-sys-color-accent);
  }
  .life-src {
    color: var(--md-sys-color-outline);
    text-decoration: none;
  }
  .life-src:hover {
    color: var(--md-sys-color-primary);
  }
  @media (max-width: 639px) {
    .life-hud {
      display: none;
    }
  }

  /* ── Crosshair ──────────────────────────────────────────────────── */
  .crosshair {
    position: absolute;
    pointer-events: none;
    background: var(--md-sys-color-accent);
    opacity: 0;
    transition: opacity var(--md-sys-motion-spring-fast-effects);
  }
  .crosshair-x {
    left: 0;
    right: 0;
    height: 1px;
    top: 0;
    transform: translateY(var(--my, 0px));
  }
  .crosshair-y {
    top: 0;
    bottom: 0;
    width: 1px;
    left: 0;
    transform: translateX(var(--mx, 0px));
  }
  .drawing[data-tracking="true"] .crosshair {
    opacity: 0.4;
  }
  @media (hover: hover) {
    .drawing {
      cursor: crosshair;
    }
  }

  .readout {
    position: absolute;
    top: var(--md-sys-spacing-3);
    left: var(--md-sys-spacing-4);
    margin: 0;
    color: var(--md-sys-color-accent);
    opacity: 0;
    transition: opacity var(--md-sys-motion-spring-fast-effects);
  }
  .drawing[data-tracking="true"] .readout {
    opacity: 1;
  }

  @keyframes grid-in {
    from {
      opacity: 0;
      background-size: 96px 96px;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes boot-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes callout-in {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes callout-in-right {
    from {
      opacity: 0;
      clip-path: inset(0 0 0 100%);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  /* ── Specimen & dimension lines ─────────────────────────────────── */
  .specimen-wrap {
    position: relative;
    z-index: 2;
  }

  .specimen {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(18px, 2.4vw, 30px) clamp(24px, 3.4vw, 44px);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-blueprint-rule);
    background: color-mix(in srgb, var(--md-sys-color-primary) 6%, transparent);
  }
  .specimen-mark {
    height: clamp(72px, 13vw, 140px);
    width: auto;
    overflow: visible;
    /* Drifts against the pointer, so the drawing has a little parallax. */
    transform: translate3d(
      calc(var(--px, 0.5) * 14px - 7px),
      calc(var(--py, 0.5) * 14px - 7px),
      0
    );
    transition: transform var(--md-sys-motion-spring-default-spatial);
  }

  /* The mark gets drafted onto the sheet, outline first. */
  .ink {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draft 1.4s var(--md-sys-motion-easing-emphasized) 0.6s forwards;
  }
  .ink-shell {
    stroke: var(--md-sys-color-primary);
    stroke-width: 11;
  }
  .ink-fill {
    stroke: var(--md-sys-color-accent);
    stroke-width: 7;
    animation-delay: 1.1s;
  }
  /* A whisper of fill once the outline lands, so it reads as a solid part. */
  .specimen-wrap {
    --wash: 0;
    animation:
      boot-in 0.6s var(--md-sys-motion-easing-emphasized) 0.35s both,
      wash-in 0.9s ease-out 2.2s forwards;
  }
  .ink-fill {
    fill: var(--md-sys-color-wash);
    fill-opacity: var(--wash);
  }

  @keyframes draft {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes wash-in {
    to {
      --wash: 1;
    }
  }

  /* Ticked rules that measure the specimen — and read as career facts. */
  .dim {
    position: absolute;
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--md-sys-color-accent);
  }
  .dim::before,
  .dim::after {
    content: "";
    position: absolute;
    background: currentColor;
    opacity: 0.55;
  }
  .dim-label {
    position: relative;
    padding: 0 6px;
    color: var(--md-sys-color-accent);
    background: var(--md-sys-color-surface);
    letter-spacing: 0.12em;
  }

  /* Horizontal, under the specimen: |—— 2019 — 2026 ——| */
  .dim-h {
    left: 0;
    right: 0;
    bottom: -26px;
    height: 1px;
    background: linear-gradient(
      90deg,
      currentColor 0 100%
    );
  }
  .dim-h::before,
  .dim-h::after {
    top: -4px;
    width: 1px;
    height: 9px;
  }
  .dim-h::before {
    left: 0;
  }
  .dim-h::after {
    right: 0;
  }

  /* Vertical, left of the specimen. */
  .dim-v {
    top: 0;
    bottom: 0;
    left: -26px;
    width: 1px;
    background: currentColor;
  }
  .dim-v::before,
  .dim-v::after {
    left: -4px;
    height: 1px;
    width: 9px;
  }
  .dim-v::before {
    top: 0;
  }
  .dim-v::after {
    bottom: 0;
  }
  .dim-v .dim-label {
    padding: 6px 0;
    writing-mode: vertical-rl;
  }

  .callout {
    position: absolute;
    display: none;
    align-items: center;
    gap: var(--md-sys-spacing-2);
    animation: callout-in 0.5s var(--md-sys-motion-easing-emphasized)
      var(--boot-delay, 0.55s) both;
  }
  .callout[data-side="left"] {
    left: var(--md-sys-spacing-6);
  }
  .callout[data-side="right"] {
    right: var(--md-sys-spacing-6);
    flex-direction: row-reverse;
    animation-name: callout-in-right;
  }
  .callout-key {
    color: var(--md-sys-color-accent);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-blueprint-rule);
    padding: 2px 6px;

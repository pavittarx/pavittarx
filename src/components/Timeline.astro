// Filter at build time, not in the browser. Rendering every entry on all
// three routes and hiding the rest with JS made /timeline, /projects and
// /blog near-identical to a crawler — classic duplicate content.
const matches = (category: string) =>
  initialFilter === "all"
    ? true
    : initialFilter === "education"
      ? category === "education" || category === "certification"
      : category === initialFilter;

const visibleEvents = events
  .map((group) => ({ ...group, items: group.items.filter((i) => matches(i.category)) }))
  .filter((group) => group.items.length > 0);

// Chips only make sense on the combined view; a dedicated page filtering
// itself away is just confusing.
const showFilters = initialFilter === "all";
---

<section id="timeline" data-initial-filter={initialFilter}>
  {
    showFilters && (
      <div class="filters">
        {
      [
        { id: "all", label: "All" },
        { id: "work", label: "Work" },
        { id: "blog", label: "Blog" },
        { id: "education", label: "Education & Certs" },
        { id: "project", label: "Projects" },
      ].map((filter) => (
        <button
          class={`filter-btn md-label-medium ${filter.id === "all" ? "active" : ""}`}
          data-filter={filter.id}
        >
          {filter.label}
            </button>
          ))
        }
      </div>
    )
  }

  <div class="log">
    {
      visibleEvents.map((group) => (
        <div class="group-container">
          <div class="year-col">
            <div class="year-marker md-cut">
              <h2 class="md-display-small year">{group.year}</h2>
            </div>
          </div>

          <div class="entries">
            {group.items.map((item, index) => (
              <article
                class="timeline-item"
                data-category={item.category}
                style={`top: calc(var(--tl-stick) + ${index * 1.25}rem); z-index: ${10 + index};`}
              >
                <span class="entry-node" aria-hidden="true" />

                <div class="entry-card md-cut">
                <div class="entry-head">
                  <span
                    class="md-label-small entry-tag"
                    data-category={item.category}
                  >
                    {item.category}
                  </span>
                  {item.date && (
                    <span class="md-label-small entry-date">{item.date}</span>
                  )}
                </div>

                <h3 class="md-title-large entry-title">
                  {item.link ? (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="entry-link"
                    >
                      <span>{item.title}</span>
                      <span class="entry-ext" aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>

                {item.description && (
                  <p class="md-body-medium entry-desc" set:html={item.description} />
                )}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Clearance under the sticky nav rail. Single-column layouts park the year
     above the stack, so cards need to clear the marker too. */
  #timeline {
    --tl-stick-year: 6rem;
    --tl-stick: 9.5rem;
  }

  /* ── Filters ────────────────────────────────────────────────────── */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-sys-spacing-2);
    padding-bottom: var(--md-sys-spacing-6);
    border-bottom: var(--md-sys-frame-rule) solid
      var(--md-sys-color-outline-variant);
  }

  .filter-btn {
    cursor: pointer;
    padding: var(--md-sys-spacing-2) var(--md-sys-spacing-4);
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-low);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-outline-variant);
    --cut: var(--md-sys-shape-cut-small);
    transition:
      --cut var(--md-sys-motion-spring-fast-spatial),
      color var(--md-sys-motion-spring-default-effects),
      border-color var(--md-sys-motion-spring-default-effects),
      background-color var(--md-sys-motion-spring-default-effects);
  }
  .filter-btn:hover {
    --cut: var(--md-sys-shape-cut-large);
    color: var(--md-sys-color-primary);
    border-color: var(--md-sys-color-primary);
  }
  .filter-btn.active {
    --cut: var(--md-sys-shape-cut-large);
    color: var(--md-sys-color-on-primary-container);
    background: var(--md-sys-color-primary-container);
    border-color: var(--md-sys-color-primary);
  }

  /* ── Groups ─────────────────────────────────────────────────────── */
  .log {
    padding-top: var(--md-sys-spacing-8);
  }

  .group-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--md-sys-spacing-4);
    padding-bottom: var(--md-sys-spacing-12);
  }

  /* Year rides the group's grid area, so it stays pinned for the whole year —
     sticking the marker itself only works while its own row is on screen. */
  .year-col {
    position: sticky;
    top: var(--tl-stick-year);
    align-self: start;
    z-index: 45;
  }

  /* Boxed like a drawing's section marker. */
  .year-marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--md-sys-spacing-2) var(--md-sys-spacing-4);
    background: var(--md-sys-color-surface-container-low);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-primary);
    --cut: var(--md-sys-shape-cut-medium);
  }
  .year {
    margin: 0;
    color: var(--md-sys-color-primary);
    line-height: 1;
  }

  /* ── Spine ──────────────────────────────────────────────────────── */
  .entries {
    position: relative;
    padding-left: var(--md-sys-spacing-6);
    border-left: var(--md-sys-frame-rule) solid
      var(--md-sys-color-outline-variant);
  }

  /* ── Entry ──────────────────────────────────────────────────────── */
  /* Sticky + staggered: cards collect into a stack as the year scrolls past. */
  /* Wrapper carries sticky + the spine tick; it must stay unclipped, or the
     card's clip-path would cut the tick off. */
  .timeline-item {
    position: sticky;
    margin-bottom: var(--md-sys-spacing-3);
  }
  .entry-card {
    padding: var(--md-sys-spacing-4);
    background: var(--md-sys-color-surface-container-low);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-outline-variant);
    --cut: var(--md-sys-shape-cut-medium);
    transition:
      --cut var(--md-sys-motion-spring-fast-spatial),
      border-color var(--md-sys-motion-spring-default-effects),
      background-color var(--md-sys-motion-spring-default-effects);
  }
  .timeline-item:hover .entry-card {
    --cut: var(--md-sys-shape-cut-extra-extra-large);
    border-color: var(--md-sys-color-primary);
    background: var(--md-sys-color-surface-container);
  }

  /* Tick on the spine, with a short leader into the card. */
  .entry-node {
    position: absolute;
    top: var(--md-sys-spacing-6);
    left: calc(var(--md-sys-spacing-6) * -1 - 4px);
    width: 7px;
    height: 7px;
    background: var(--md-sys-color-surface);
    border: var(--md-sys-frame-rule) solid var(--md-sys-color-accent);
    transition: background-color var(--md-sys-motion-spring-default-effects);
  }
  .entry-node::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    width: calc(var(--md-sys-spacing-6) - 3px);
    height: 1px;
    background: var(--md-sys-color-outline-variant);
  }
  .timeline-item:hover .entry-node {
    background: var(--md-sys-color-accent);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--md-sys-spacing-2);
    padding-bottom: var(--md-sys-spacing-3);
    margin-bottom: var(--md-sys-spacing-3);
    border-bottom: var(--md-sys-frame-rule) solid
      var(--md-sys-color-outline-variant);
  }

  /* Category is coded by colour the way a drawing codes layers. */
  .entry-tag {
    padding: 2px 8px;
    border: var(--md-sys-frame-rule) solid currentColor;
  }
  .entry-tag[data-category="work"] {
    color: var(--md-sys-color-accent);
    background: var(--md-sys-color-accent-tint);
  }
  .entry-tag[data-category="project"] {
    color: var(--md-sys-color-primary);
    background: var(--md-sys-color-primary-tint);
  }
  .entry-tag[data-category="blog"] {
    color: var(--md-sys-color-tertiary);
    background: var(--md-sys-color-tertiary-tint);
  }
  .entry-tag[data-category="education"],
  .entry-tag[data-category="certification"] {
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-high);
  }

  .entry-date {
    color: var(--md-sys-color-outline);
  }

  .entry-title {
    margin: 0 0 var(--md-sys-spacing-2);
    color: var(--md-sys-color-on-surface);
  }
  .entry-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--md-sys-spacing-2);
    color: inherit;
    text-decoration: none;
  }
  .entry-link:hover {
    color: var(--md-sys-color-primary);
  }
  .entry-ext {
    font-family: var(--md-sys-typescale-mono-font);
    font-size: 0.75em;
    color: var(--md-sys-color-outline);
  }
  .entry-link:hover .entry-ext {
    color: var(--md-sys-color-primary);
  }

  .entry-desc {
    margin: 0;
    max-width: 76ch;
  }
  /* Descriptions carry inline links from the source data. */
  .entry-desc :global(a) {
    color: var(--md-sys-color-primary);
    text-decoration: none;
    border-bottom: var(--md-sys-frame-rule) solid
      var(--md-sys-color-outline-variant);
  }
  .entry-desc :global(a:hover) {
    border-bottom-color: var(--md-sys-color-primary);
  }

  @media (min-width: 900px) {
    /* Year moves into its own column, so cards reclaim the clearance. */
    #timeline {
      --tl-stick: 6rem;
    }
    .group-container {
      grid-template-columns: 7rem 1fr;
      gap: var(--md-sys-spacing-8);
      padding-bottom: var(--md-sys-spacing-16);
    }
    .year-col {
      display: flex;
      justify-content: flex-end;
    }
    .entries {
      padding-left: var(--md-sys-spacing-8);
    }
    .entry-node {
      left: calc(var(--md-sys-spacing-8) * -1 - 4px);
    }
    .entry-node::after {
      width: calc(var(--md-sys-spacing-8) - 3px);
    }
    .entry-card {
      padding: var(--md-sys-spacing-6);
    }
  }

  /* The stack reads as depth; without motion it just reads as overlap. */
  @media (prefers-reduced-motion: reduce) {
    .timeline-item,
    .year-col {
      position: static;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const items = document.querySelectorAll(".timeline-item");
  const groups = document.querySelectorAll(".group-container");
  const timelineSection = document.getElementById("timeline");

  function applyFilter(filter: string) {
    buttons.forEach((b) => {
      b.classList.toggle(
        "active",
        (b as HTMLElement).dataset.filter === filter,
      );
    });

    items.forEach((item) => {
      const category = (item as HTMLElement).dataset.category;
      const isVisible =
        filter === "all"
          ? true
          : filter === "education"
            ? category === "education" || category === "certification"
            : category === filter;

      (item as HTMLElement).style.display = isVisible ? "" : "none";
    });

    groups.forEach((group) => {
      const hasVisibleItems = Array.from(
        group.querySelectorAll(".timeline-item"),
      ).some((item) => (item as HTMLElement).style.display !== "none");
      (group as HTMLElement).style.display = hasVisibleItems ? "" : "none";
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = (btn as HTMLElement).dataset.filter;
      if (filter) applyFilter(filter);
    });
  });

  if (timelineSection && timelineSection.dataset.initialFilter) {
    applyFilter(timelineSection.dataset.initialFilter);
  }
</script>

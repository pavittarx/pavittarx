---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Keep a page out of search results (internal reference pages). */
  noindex?: boolean;
}

const {
  title = "Pavittar Singh — Senior Software Engineer",
  description =
    "Senior software engineer with 6+ years building product-grade backends and full-stack web apps. Node, NestJS and Postgres on AWS, with hands-on AI and agentic tooling.",
  noindex = false,
} = Astro.props;

// Absolute URLs — social scrapers and canonical both reject relative ones.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Pavittar Singh",
  alternateName: "pavittarx",
  url: "https://pavittarx.com",
  image: ogImage.href,
  jobTitle: "Senior Software Engineer",
  email: "mailto:pavittarx@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressRegion: "Uttarakhand",
    addressCountry: "IN",
  },
  worksFor: { "@type": "Organization", name: "Kuby Ltd." },
  sameAs: [
    "https://github.com/pavittarx",
    "https://linkedin.com/in/pavittarx",
    "https://blog.pavittarx.com",
  ],
  knowsAbout: [
    "Node.js",
    "NestJS",
    "TypeScript",
    "PostgreSQL",
    "AWS",
    "Next.js",
    "Astro",
    "AI tooling",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>

    <!-- Resolve the theme before first paint, or the dark default flashes. -->
    <script is:inline>
      (() => {
        let t;
        try {
          t = localStorage.getItem("pavittarx:theme");
        } catch {}
        if (t !== "light" && t !== "dark") {
          t = matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      />
    </noscript>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pavittar Singh" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Pavittar Singh — Senior Software Engineer, drawn as a technical schematic"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(person)}
    />
  </head>
  <body>
    <slot />

    <script>
      // Every page carries a scheme toggle in its nav rail.
      const THEME_KEY = "pavittarx:theme";

      function paintThemeLabels() {
        const t =
          document.documentElement.dataset.theme === "light" ? "Light" : "Dark";
        document
          .querySelectorAll("[data-theme-label]")
          .forEach((el) => (el.textContent = t));
      }
      paintThemeLabels();

      document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "light"
              ? "dark"
              : "light";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem(THEME_KEY, next);
          } catch {}
          paintThemeLabels();
        });
      });
    </script>
  </body>
</html>

